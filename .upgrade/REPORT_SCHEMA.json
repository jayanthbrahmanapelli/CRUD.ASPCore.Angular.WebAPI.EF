{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Upgrade hop report",
  "type": "object",
  "required": [
    "hop",
    "status",
    "summary"
  ],
  "properties": {
    "hop": {
      "type": "string",
      "description": "The hop slug, e.g. 01-v8-to-v9"
    },
    "status": {
      "enum": [
        "done",
        "blocked"
      ]
    },
    "summary": {
      "type": "string",
      "description": "Two or three sentences: what changed and why."
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "One line per notable change."
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "from",
          "to"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          }
        }
      }
    },
    "manual_followups": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Things a person should check or finish; empty when nothing is left."
    },
    "blocked_reason": {
      "type": "string",
      "description": "Required when status is blocked."
    }
  }
}
